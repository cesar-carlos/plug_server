                  "type": "string",
                  "minLength": 1
                },
                "auth": {
                  "type": "string",
                  "minLength": 1
                },
                "trace_id": {
                  "type": "string",
                  "minLength": 1
                },
                "requested_by": {
                  "type": "string",
                  "minLength": 1
                },
                "action_id": {
                  "type": "string",
                  "minLength": 1
                },
                "idempotency_key": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger_id": {
