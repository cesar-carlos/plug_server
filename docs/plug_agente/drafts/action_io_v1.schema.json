              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer"
                }
              ]
            },
            "method": {
              "const": "agent.action.sendInput"
            },
            "params": {
              "type": "object",
              "properties": {
                "client_token": {
                  "type": "string",
                  "minLength": 1
                },
                "clientToken": {
                  "type": "string",
                  "minLength": 1
                },
                "auth": {
                  "type": "string",
                  "minLength": 1
                },
                "trace_id": {
                  "type": "string",
                  "minLength": 1
                },
