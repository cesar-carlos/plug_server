            "params": {
              "type": "object",
              "properties": {
                "client_token": {
                  "type": "string",
                  "minLength": 1
                },
                "clientToken": {
                  "type": "string",
                  "minLength": 1
                },
                "auth": {
                  "type": "string",
                  "minLength": 1
                },
                "trace_id": {
                  "type": "string",
                  "minLength": 1
                },
                "requested_by": {
                  "type": "string",
                  "minLength": 1
                },
                "execution_id": {
                  "type": "string",
                  "minLength": 1
                },
                "message_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "execution_id",
