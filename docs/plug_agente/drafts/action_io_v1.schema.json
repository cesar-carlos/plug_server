          "type": "object",
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "$ref": "#/$defs/errorData"
            }
          },
          "required": [
            "code",
            "message",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
