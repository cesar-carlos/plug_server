{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:plug:draft:action-io:1",
  "title": "PROPOSED action I/O v1 â€” not a runtime contract",
  "description": "Documentation-only proposal. Does not enable methods or capabilities.",
  "anyOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/capability"
    }
  ],
  "$defs": {
    "io": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "const": "faithful"
        },
        "initial_input_base64": {
          "type": "string",
          "maxLength": 87384,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "close_input": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "mode",
        "close_input"
      ],
      "additionalProperties": false
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer"
                }
              ]
            },
            "method": {
              "const": "agent.action.run"
            },
            "params": {
              "type": "object",
              "properties": {
                "client_token": {
                  "type": "string",
                  "minLength": 1
