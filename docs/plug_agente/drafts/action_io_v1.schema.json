                "requested_by": {
                  "type": "string",
                  "minLength": 1
                },
                "execution_id": {
                  "type": "string",
                  "minLength": 1
                },
                "message_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
