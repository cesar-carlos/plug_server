      "required": [
        "code",
        "phase",
        "origin",
        "diagnostic_id",
        "effects_possible",
        "retryable",
        "recovery"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "integer"
            }
          ]
