                  "type": "string",
                  "minLength": 1
                },
                "trigger_id": {
                  "type": "string",
                  "minLength": 1
                },
                "io": {
                  "$ref": "#/$defs/io"
                }
              },
              "required": [
                "action_id",
                "idempotency_key",
                "io"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
