    "deliveryState": {
      "enum": [
        "accepted",
        "writing",
        "written",
        "failed",
        "unknown"
      ]
    },
    "stdinState": {
      "enum": [
        "pending",
        "open",
        "closing",
        "closed",
        "failed"
      ]
    },
    "errorData": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "ACTION_OUTCOME_UNKNOWN",
            "ACTION_STDIN_WRITE_TIMEOUT",
            "ACTION_STDIN_PARTIAL_WRITE",
            "ACTION_INPUT_CONFLICT",
            "ACTION_INPUT_SEQUENCE_INVALID",
            "ACTION_INPUT_QUEUE_FULL",
            "ACTION_STDIN_CLOSED",
            "ACTION_IO_UNSUPPORTED",
            "ACTION_IO_INVALID_INPUT",
            "ACTION_OUTPUT_LIMIT_EXCEEDED",
            "ACTION_IO_STORAGE_FAILED",
            "ACTION_IO_INTEGRITY_FAILED",
            "ACTION_IO_KEY_UNAVAILABLE",
            "ACTION_IO_TERMINATION_FAILED",
            "OUTPUT_EXPIRED",
            "ACTION_IO_CURSOR_INVALID"
          ]
        },
        "phase": {
          "enum": [
            "admission",
            "stdin_write",
            "capture",
            "persist",
            "read",
            "terminate",
            "await_response"
          ]
        },
        "origin": {
          "enum": [
            "hub",
            "agent",
            "runner",
            "storage"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_id": {
          "type": "string",
          "minLength": 1
        },
        "delivery_state": {
          "$ref": "#/$defs/deliveryState"
        },
        "confirmed_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "effects_possible": {
          "type": "boolean"
        },
        "retryable": {
          "const": false
        },
        "recovery": {
          "enum": [
            "correct_request",
            "wait_capacity",
            "query_message",
            "query_execution",
            "reconcile_execution",
            "local_intervention"
          ]
        },
        "hint": {
          "type": "string",
          "minLength": 1
        }
