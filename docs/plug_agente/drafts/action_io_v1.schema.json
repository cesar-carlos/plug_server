              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer"
