APP_NAME=plug_server
# Root landing (`GET /`): pt | en | auto (from Accept-Language, default Portuguese)
# ROOT_LANDING_LANG=auto
NODE_ENV=development
#
# Test/container overrides for dependency injection.
# `auto` keeps the default behaviour:
# - test -> memory persistence + noop email
# - non-test -> Prisma persistence + SMTP email
# CONTAINER_PERSISTENCE_MODE=auto
# CONTAINER_EMAIL_SENDER_MODE=auto
# Express trust proxy: correct req.ip / rate-limit behind nginx. Default true if NODE_ENV=production, else false.
# HTTP_TRUST_PROXY=true
PORT=3000
# CORS: "*" allows any origin (cookies disabled). For production, pass either a
# single origin or a comma-separated list (e.g. "https://app.example.com,https://admin.example.com"); credentials are enabled when a list is provided.
CORS_ORIGIN=*
# Default Express JSON/urlencoded limit for most routes. JSON-only `POST /api/v1/client/me/socket-events`
# uses `REST_SOCKET_EVENT_HTTP_JSON_BODY_LIMIT` when set, otherwise a derived limit from `REST_SOCKET_EVENT_*`.
REQUEST_BODY_LIMIT=1mb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plug_server?schema=public
# Prisma connection pool: defaults to ~10 connections per Node process. Tune via
# `?connection_limit=N&pool_timeout=10` in DATABASE_URL when running multiple
# replicas behind the same Postgres so the cluster total stays within the
# server's `max_connections`. Example for 4 replicas × 25 conns:
# DATABASE_URL=postgresql://...?schema=public&connection_limit=25&pool_timeout=10
# Client→agent approval/reject uses Prisma interactive transactions. Poolers in "transaction" mode (some PgBouncer configs) can fail those txns; prefer session/direct Postgres or your host's recommended URL.
# If approve/reject returns 503, check logs: client_agent_access_txn_failed or client_agent_access_txn_prisma_error (includes prismaCode).
# Retry transient serialization/deadlock errors in critical Prisma transactions.
# DATABASE_TRANSACTION_RETRY_MAX_ATTEMPTS=3
# DATABASE_TRANSACTION_RETRY_BASE_DELAY_MS=25
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plug_server
POSTGRES_PORT=5432

# Access token — short-lived (15m recommended for production)
JWT_ACCESS_SECRET=change-me-access-development
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token — long-lived (7d recommended for production)
JWT_REFRESH_SECRET=change-me-refresh-development
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=plug_server
JWT_AUDIENCE=plug_clients
# In-memory cache of access-token verification results. Cache hits re-check the
# JWT `exp` claim so expired tokens are never served. 0 disables the cache.
# JWT_VERIFY_CACHE_TTL_MS=30000
# JWT_VERIFY_CACHE_MAX_SIZE=2000

# TTL (ms) for the /metrics response Buffer cache. Cache hits skip the
# synchronous Prometheus render. Default 500 collapses scraper bursts; raise it
# on busy hubs with aggressive scrape intervals. 0 disables the cache.
# METRICS_RESPONSE_CACHE_TTL_MS=500

# OpenTelemetry auto-instrumentation (HTTP/Express/Prisma). Disabled by default;
# when enabled, point OTEL_EXPORTER_OTLP_ENDPOINT at the collector. Sampler ratio
# defaults to 5% to keep traces representative without overwhelming downstream.
# OTEL_TRACES_ENABLED=false
# OTEL_TRACES_SAMPLER_ARG=0.05
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=plug_server

# Logging
# LOG_LEVEL=info  # trace|debug|info|warn|error|fatal — pino structured JSON to stdout

# Public URL of this API (used in registration approval emails). No trailing slash.
# Must match the API instance that uses this DATABASE_URL: links in emails call this host;
# if you point APP_BASE_URL at production while running against a local DB, tokens exist only locally and approval fails on the public server.
APP_BASE_URL=http://localhost:3000
# Owner eligibility for client self-register: npm run db:registration:owner -- owner@example.com (uses DATABASE_URL; add DATABASE_URL=… on the same command for production).
# Pre-citext duplicate scan (same email different casing): npm run db:email:dup-scan
# Local: default "uploads". Producao com Nginx alias: mesmo path absoluto que no servidor (ex.: /var/lib/plug_server/uploads)
# UPLOADS_DIR=uploads
# Receives "approve / reject" emails for new registrations
ADMIN_EMAIL=admin@se7esistemassinop.com.br
# se7esistemassinop SMTP (SSL/TLS)
SMTP_HOST=mail.se7esistemassinop.com.br
SMTP_PORT=465
SMTP_USER=your-user@se7esistemassinop.com.br
SMTP_PASS=
# e.g. Plug Server <your-address@domain.com> — if empty, uses APP_NAME + SMTP_USER
SMTP_FROM=Plug Server <your-user@se7esistemassinop.com.br>
# Registration approval link lifetime (same shorthand as JWT refresh: 7d, 24h, …)
APPROVAL_TOKEN_EXPIRES_IN=7d
# Production: refuse to start without SMTP (default true). Set false only in exceptional setups.
REQUIRE_SMTP_IN_PRODUCTION=true
# When true, registration emails are sent after the HTTP handler returns (recommended in production).
REGISTRATION_EMAIL_ASYNC=true
# Max attempts per registration email operation (including first send attempt).
REGISTRATION_EMAIL_MAX_RETRIES=3
# Delay between retries in milliseconds.
REGISTRATION_EMAIL_RETRY_DELAY_MS=1500
# Persist registration emails to outbox and process in background worker.
REGISTRATION_EMAIL_OUTBOX_ENABLED=true
# Worker poll cadence in milliseconds.
REGISTRATION_EMAIL_OUTBOX_POLL_INTERVAL_MS=3000
# Max rows handled per poll cycle.
REGISTRATION_EMAIL_OUTBOX_BATCH_SIZE=25
# Max attempts per outbox row before dead-letter.
REGISTRATION_EMAIL_OUTBOX_MAX_ATTEMPTS=10
# Base delay for exponential retry backoff in milliseconds.
REGISTRATION_EMAIL_OUTBOX_RETRY_BASE_DELAY_MS=5000
# Lock reclaim timeout in milliseconds (stuck worker recovery).
REGISTRATION_EMAIL_OUTBOX_LOCK_TIMEOUT_MS=300000
# Max parallel SMTP sends per outbox flush. Default 4 keeps legacy single-replica behaviour.
# Generous profile: 8+ when SMTP provider tolerates parallel connections.
# REGISTRATION_EMAIL_OUTBOX_WORKER_CONCURRENCY=4
# Deliverability: configure SPF/DKIM for your SMTP_FROM domain in your DNS (Microsoft 365 / Outlook).

# Optional PayloadFrame signature verification (HMAC-SHA256).
# If PAYLOAD_SIGNING_KEY is set, signed socket frames are verified.
PAYLOAD_SIGNING_KEY=
PAYLOAD_SIGNING_KEY_ID=
# JSON object of previous key ids accepted only for inbound verification, e.g. {"old-key":"secret"}.
PAYLOAD_SIGNING_PREVIOUS_KEYS_JSON=
# When true, hub signs outbound PayloadFrames (requires PAYLOAD_SIGNING_KEY).
PAYLOAD_SIGN_OUTBOUND=false
# Min UTF-8 bytes before encodePayloadFrame / encodePayloadFrameBridge attempt gzip (default 4096). Smaller → cmp:none.
PAYLOAD_FRAME_COMPRESS_MIN_BYTES=4096
# Max UTF-8 bytes of JSON before hub tries gzip (default 512 KiB). Larger → cmp:none until 10 MiB frame cap.
PAYLOAD_FRAME_MAX_GZIP_INPUT_BYTES=524288
# Optional zlib level 1–9 for hub PayloadFrame gzip. If unset: NODE_ENV=production → 3 (faster CPU); else Node default (~6).
# PAYLOAD_FRAME_GZIP_LEVEL=
# In auto mode, only keep gzip when the savings beat this many bytes (avoids CPU cost for marginal wins).
PAYLOAD_FRAME_AUTO_GZIP_MIN_SAVINGS_BYTES=64
# Hub→agent bridge: async zlib gzip for eligible JSON at least this many UTF-8 bytes (0 = always sync gzip).
PAYLOAD_FRAME_ASYNC_GZIP_MIN_UTF8_BYTES=131072
# Inbound gzip: async gunzip for compressed PayloadFrame at least this many bytes (0 = always sync).
PAYLOAD_FRAME_ASYNC_GUNZIP_MIN_COMPRESSED_BYTES=65536
# Max offline agent IDs remembered for REST 404 vs 503 (0 = unlimited).
SOCKET_AGENT_KNOWN_IDS_MAX=0
# Grace window after agent:register before first dispatch; heartbeat clears it early.
SOCKET_AGENT_PROTOCOL_READY_GRACE_MS=100
# Max concurrent post-register agent.getProfile catalog sync RPCs (default 8).
SOCKET_AGENT_PROFILE_SYNC_MAX_CONCURRENT=8
# Second agent:register for same agentId: reject_active | takeover_disconnect_previous | legacy_silent_takeover (default reject_active).
SOCKET_AGENT_SESSION_POLICY=reject_active
# Optional sliding-window limit on agent:register per (userId, agentId). Both must be >0 to enable; 0 disables.
SOCKET_AGENT_REGISTER_RATE_LIMIT_WINDOW_MS=0
SOCKET_AGENT_REGISTER_RATE_LIMIT_MAX=0
# After ownership eligibility, skip repeated catalog stub + bindIfUnbound within TTL (ms). 0 disables.
AGENT_REGISTER_BIND_CACHE_TTL_MS=5000
AGENT_REGISTER_BIND_CACHE_MAX_SIZE=2000

# /agents JWT handshake: true (default). false allows anonymous /agents only when NODE_ENV=test;
# production bootstrap aborts if false. /consumers always requires JWT regardless of this flag.
SOCKET_AUTH_REQUIRED=true
# Disconnect registered /agents sockets idle longer than this threshold (ms). 0 disables.
# Prometheus: plug_agent_idle_timeout_disconnect_total
SOCKET_AGENT_IDLE_TIMEOUT_MS=1800000
# Background sweep cadence for SOCKET_AGENT_IDLE_TIMEOUT_MS. 0 disables the scheduler.
# Optional stable prod tuning: 120000 reduces sweep CPU; timeout policy unchanged.
SOCKET_AGENT_IDLE_SWEEP_INTERVAL_MS=60000
# Disconnect connected /consumers sockets idle longer than this threshold (ms). 0 disables.
# Prometheus: plug_consumer_idle_timeout_disconnect_total
SOCKET_CONSUMER_IDLE_TIMEOUT_MS=1800000
# Background sweep cadence for SOCKET_CONSUMER_IDLE_TIMEOUT_MS. 0 disables the scheduler.
# Optional stable prod tuning: 120000 reduces sweep CPU; timeout policy unchanged.
SOCKET_CONSUMER_IDLE_SWEEP_INTERVAL_MS=60000
# Socket.IO handshake token precedence (both /agents and /consumers): `handshake.auth.token` wins over
# `Authorization: Bearer` in handshake headers when both are present. Prefer auth.token for clients.
# Optional: skip repeated DB account checks on the same socket for this many ms (0 = always query DB).
# Applies to `/consumers` per-event guards too (`socket:event.*`, relay, agents:command):
# within the TTL the hub reuses the same active-account snapshot instead of hitting the DB again.
SOCKET_AUTH_ACCOUNT_SNAPSHOT_TTL_MS=0
# Per-socket agent-access guard cache (0 = always re-check assertPrincipalAccess).
# Recommended staging/prod (opt-in): 15000 — fewer assertPrincipalAccess / room-join DB round-trips on hot
# consumer sockets. Trade-off: revocations may lag up to TTL unless invalidation hooks fire.
SOCKET_CONSUMER_AGENT_ACCESS_SNAPSHOT_TTL_MS=0
# Comma-separated roles allowed in /agents (default: agent)
SOCKET_AGENT_ROLES=agent
# Comma-separated roles allowed in /consumers (default: user,admin,client).
# The literal "client" is required for Colmeia (JWT role=client). If you omit "client" in the
# list, the process appends it at boot and logs INFO socket_consumer_roles_ensured_client.
SOCKET_CONSUMER_ROLES=user,admin,client
# When true (default), hub broadcasts `client:agent.profile.updated` to approved clients on /consumers
# whenever the agent catalog profile changes. Set to "false" as an operational kill-switch
# (REST keeps working; clients fall back to polling). Requires restart.
SOCKET_CLIENT_AGENT_PROFILE_PUSH_ENABLED=true
# Short TTL + bounded cache for active approved client recipients per agent profile push.
# Dev default stays 1000 for freshness. Recommended staging/prod (opt-in): 10000 — fewer recipient-list
# fetches during catalog update bursts. Trade-off: newly approved clients may miss one push until TTL
# expires (periodic room reconcile still repairs membership).
SOCKET_CLIENT_AGENT_PROFILE_RECIPIENT_CACHE_TTL_MS=1000
SOCKET_CLIENT_AGENT_PROFILE_RECIPIENT_CACHE_MAX_SIZE=5000
# Periodic best-effort reconciliation of `consumer:client-agent:*` rooms for connected client sockets.
# 0 disables the sweep. Useful to repair missed joins/leaves after approvals/revocations or replica churn.
SOCKET_CONSUMER_CLIENT_AGENT_ROOM_RECONCILE_INTERVAL_MS=30000
SOCKET_CONSUMER_CLIENT_AGENT_ROOM_RECONCILE_CONCURRENCY=8
SOCKET_CONSUMER_CLIENT_AGENT_ROOM_RECONCILE_MAX_CLIENTS_PER_TICK=200
SOCKET_CONSUMER_CLIENT_AGENT_ROOM_RECONCILE_START_JITTER_MS=1000
# Optional TTL (ms) to cache listApprovedAgentIds across reconcile ticks/bootstrap.
# Cuts repeated DB reads per client at the cost of a bounded convergence delay
# (live grant/revoke still push updates). 0 disables (fetch fresh each time).
# SOCKET_CONSUMER_RECONCILE_APPROVED_AGENTS_CACHE_TTL_MS=0
# Custom REST -> Socket pub/sub subscription controls on /consumers. 0 disables a given cap.
SOCKET_CUSTOM_EVENT_MAX_SUBSCRIPTIONS_PER_SOCKET=128
SOCKET_CUSTOM_EVENT_SUBSCRIPTION_RATE_LIMIT_WINDOW_MS=60000
SOCKET_CUSTOM_EVENT_SUBSCRIPTION_RATE_LIMIT_MAX=240
# Optional: max concurrent socket:event.publish async operations per /consumers connection.
# 0 = share SOCKET_CONSUMER_MAX_INFLIGHT_PER_SOCKET with relay/commands/stream pull.
# SOCKET_CUSTOM_EVENT_PUBLISH_MAX_INFLIGHT_PER_SOCKET=0
# Engine.IO: max packet size (bytes). Default 10 MiB = PayloadFrame compressed ceiling.
SOCKET_IO_MAX_HTTP_BUFFER_BYTES=10485760
# false = disable WS permessage-deflate (PayloadFrame already does optional gzip)
SOCKET_IO_PER_MESSAGE_DEFLATE=false
# Comma-separated: websocket, polling. If unset: NODE_ENV=production → websocket only; else websocket,polling.
SOCKET_IO_TRANSPORTS=websocket,polling
# false = do not serve socket.io client JS from this server (recommended for API hub)
SOCKET_IO_SERVE_CLIENT=false
# Optional: Socket.IO Redis adapter for rooms/pubsub across hub replicas.
# Enables cross-replica broadcasts; still keep sticky sessions for relay conversations and agent presence.
# In NODE_ENV=production (or when SOCKET_IO_REDIS_ADAPTER_REQUIRED=true), initial connect failure aborts bootstrap when this URL is set.
# Runtime Redis errors fall back to in-memory adapter on that instance and auto-reconnect with backoff.
#
# Production: prefer rediss:// (TLS) or include credentials, e.g. redis://default:<password>@host:6379.
# Without authentication, restrict network access via VPC/firewall. See docs/redis_security.md.
# SOCKET_IO_REDIS_ADAPTER_URL=redis://127.0.0.1:6379
# Explicit fail-hard on initial Redis adapter connect failure outside production (requires URL above).
# SOCKET_IO_REDIS_ADAPTER_REQUIRED=false
# @socket.io/redis-adapter tuning (defaults match library / current hub behavior when unset):
# SOCKET_IO_REDIS_ADAPTER_KEY=socket.io
# SOCKET_IO_REDIS_ADAPTER_REQUESTS_TIMEOUT_MS=5000
# SOCKET_IO_REDIS_ADAPTER_PUBLISH_ON_SPECIFIC_RESPONSE_CHANNEL=false
# SOCKET_IO_REDIS_ADAPTER_CONNECT_TIMEOUT_MS=5000
# Hub reconnect backoff after runtime Redis adapter failure (exponential, capped):
# SOCKET_IO_REDIS_ADAPTER_RECONNECT_BASE_MS=1000
# SOCKET_IO_REDIS_ADAPTER_RECONNECT_MAX_MS=30000
# Distributed agent presence + inter-replica POST /agents/commands forward (multi-PM2).
# Uses AGENT_HUB_PRESENCE_REDIS_URL when set, else SOCKET_IO_REDIS_ADAPTER_URL. Requires unique HUB_INSTANCE_ID per replica in production.
# AGENT_HUB_PRESENCE_REDIS_URL=
# AGENT_HUB_PRESENCE_ENABLED=true
# AGENT_HUB_PRESENCE_TTL_MS=120000
# AGENT_HUB_BRIDGE_FORWARD_TIMEOUT_MS=15000
# AGENT_HUB_CLUSTER_INSTANCE_IDS=plug-4000,plug-4001
# HUB_INSTANCE_ID=plug-4000
# Engine.IO gzip for polling. If unset: NODE_ENV=production → false; else true. Set true if you use polling.
SOCKET_IO_HTTP_COMPRESSION=true
# Optional heartbeat / upgrade tuning (ms). Defaults: pingInterval 25000, pingTimeout 20000, upgradeTimeout 10000 if unset.
# SOCKET_IO_PING_INTERVAL_MS=
# SOCKET_IO_PING_TIMEOUT_MS=
# SOCKET_IO_UPGRADE_TIMEOUT_MS=
# Relay reliability and performance controls
SOCKET_RELAY_REQUEST_TIMEOUT_MS=15000
SOCKET_RELAY_STREAM_IDLE_TIMEOUT_MS=30000
# Max stream lifetime before forced expiry. Prometheus: plug_socket_relay_stream_idle_timeouts_total
SOCKET_RELAY_STREAM_MAX_LIFETIME_MS=300000
# Prometheus: plug_socket_relay_stream_lifetime_timeouts_total
SOCKET_RELAY_CONVERSATION_IDLE_TIMEOUT_MS=300000
# Background sweep for idle relay conversations (emits relay:conversation.ended reason=expired).
# Optional stable prod tuning: 120000 reduces sweep CPU; idle timeout policy unchanged.
SOCKET_RELAY_CONVERSATION_SWEEP_INTERVAL_MS=60000
SOCKET_RELAY_MAX_CONVERSATIONS=5000
SOCKET_RELAY_MAX_CONVERSATIONS_PER_CONSUMER=20
SOCKET_RELAY_MAX_PENDING_REQUESTS=10000
SOCKET_RELAY_MAX_PENDING_REQUESTS_PER_CONVERSATION=32
SOCKET_RELAY_MAX_PENDING_REQUESTS_PER_CONSUMER=128
SOCKET_RELAY_MAX_ACTIVE_STREAMS=5000
SOCKET_RELAY_MAX_BUFFERED_CHUNKS_PER_REQUEST=256
SOCKET_RELAY_MAX_TOTAL_BUFFERED_CHUNKS=25600
SOCKET_RELAY_MAX_BUFFERED_BYTES_PER_REQUEST=16777216
SOCKET_RELAY_MAX_TOTAL_BUFFERED_BYTES=268435456
SOCKET_RELAY_IDEMPOTENCY_TTL_MS=300000
# Interval between background prunes of relay idempotency maps (larger = less CPU)
SOCKET_RELAY_IDEMPOTENCY_CLEANUP_INTERVAL_MS=120000
SOCKET_RELAY_CIRCUIT_FAILURE_THRESHOLD=5
SOCKET_RELAY_CIRCUIT_OPEN_MS=30000
SOCKET_RELAY_METRICS_LOG_INTERVAL_MS=60000
# High-frequency relay/stream counter sample rate (0–1). 1 = always; 0.1 ≈ 10% (scaled totals).
SOCKET_METRICS_SAMPLE_RATE=1
SOCKET_RELAY_OUTBOUND_TAIL_STALE_MS=300000
# Optional stable prod tuning: 120000 reduces sweep CPU; outbound tail policy unchanged.
SOCKET_RELAY_OUTBOUND_SWEEP_INTERVAL_MS=60000
# 0 disables overload shedding by that signal.
SOCKET_RELAY_OUTBOUND_OVERLOAD_BACKLOG=200
SOCKET_RELAY_OUTBOUND_OVERLOAD_P95_MS=250
SOCKET_RELAY_RATE_LIMIT_WINDOW_MS=10000
# Per consumer per window. Set to 0 to disable that limiter (see consumer_relay_rate_limiter).
SOCKET_RELAY_RATE_LIMIT_MAX_CONVERSATION_STARTS=8
SOCKET_RELAY_RATE_LIMIT_MAX_REQUESTS=64
SOCKET_RELAY_RATE_LIMIT_MAX_STREAM_PULL_CREDITS=1000
# Legacy agents:stream_pull credit budget per consumer per window. 0 preserves old behavior.
SOCKET_AGENTS_STREAM_PULL_RATE_LIMIT_MAX_CREDITS=0
# Optional weighted Socket agents:command costs. false preserves one event = one credit.
SOCKET_AGENTS_COMMAND_RATE_LIMIT_WEIGHTED_COSTS=false
# Relay per-agent parallelism and queue.
SOCKET_RELAY_AGENT_MAX_INFLIGHT=32
SOCKET_RELAY_AGENT_MAX_QUEUE=64
SOCKET_RELAY_AGENT_QUEUE_WAIT_MS=200
SOCKET_CONNECTION_READY_COMPAT_MODE=payload_frame
# Max concurrent async socket operations per /consumers connection (relay, commands, stream pull). 0 = unlimited.
SOCKET_CONSUMER_MAX_INFLIGHT_PER_SOCKET=32
# Outbound wire format for agents:command_response / agents:command_stream_* on /consumers.
# Inbound agents:command accepts both plain JSON and PayloadFrame during migration.
SOCKET_AGENTS_COMMAND_COMPAT_MODE=payload_frame
# Outbound wire format for agents:stream_pull_response on /consumers.
# Inbound agents:stream_pull accepts both plain JSON and PayloadFrame during migration.
SOCKET_AGENTS_STREAM_PULL_COMPAT_MODE=payload_frame
# REST bridge pending correlation budget (single + batch with IDs)
SOCKET_REST_MAX_PENDING_REQUESTS=10000
# Logical inbound contract validation after PayloadFrame decode: strict | warn | off.
SOCKET_AGENT_INBOUND_CONTRACT_VALIDATION=strict
# Retry eligible rpc:request frames once when rpc:request_ack/rpc:batch_ack does not arrive.
SOCKET_AGENT_ACK_RETRY_ENABLED=true
SOCKET_AGENT_ACK_TIMEOUT_MS=1000
SOCKET_AGENT_ACK_MAX_RETRIES=1
# Guardrails before packing sql.bulkInsert into PayloadFrame. Split larger imports into batches.
AGENT_SQL_BULK_INSERT_MAX_ROWS=50000
AGENT_SQL_BULK_INSERT_MAX_JSON_BYTES=10485760
# Agent -> hub auto-update diagnostics notification ingestion.
# Disabled by default for safe rollout. When enabled, accepts only
# `agent.autoUpdate.diagnostics.push` notifications on /agents `rpc:request`.
AGENT_AUTO_UPDATE_DIAGNOSTICS_ENABLED=false
AGENT_AUTO_UPDATE_DIAGNOSTICS_RATE_LIMIT_WINDOW_MS=60000
AGENT_AUTO_UPDATE_DIAGNOSTICS_RATE_LIMIT_MAX=1
AGENT_AUTO_UPDATE_DIAGNOSTICS_RETENTION_DAYS=90
AGENT_AUTO_UPDATE_DIAGNOSTICS_RETENTION_INTERVAL_MINUTES=1440
AGENT_AUTO_UPDATE_DIAGNOSTICS_PRUNE_BATCH_SIZE=5000
AGENT_AUTO_UPDATE_DIAGNOSTICS_MAX_PAYLOAD_BYTES=16384
AGENT_AUTO_UPDATE_DIAGNOSTICS_MAX_MESSAGE_BYTES=65536
# REST bridge per-agent overload controls (short queue + fail-fast)
# REST per-agent parallelism and queue (higher inflight = more concurrent commands per agent)
SOCKET_REST_AGENT_MAX_INFLIGHT=32
SOCKET_REST_AGENT_MAX_QUEUE=64
SOCKET_REST_AGENT_QUEUE_WAIT_MS=200
# Window size for internal rpc:stream.pull when REST materializes streaming sql.execute (larger = fewer pulls, more RAM per stream)
SOCKET_REST_STREAM_PULL_WINDOW_SIZE=256
# Max stream pull window advertised by the hub in agent:capabilities.
SOCKET_REST_STREAM_PULL_MAX_WINDOW_SIZE=256
# REST materialization guardrails for streaming sql.execute (stream_id + chunks). Rows=0 disables row cap (not recommended).
SOCKET_REST_SQL_STREAM_MATERIALIZE_MAX_ROWS=1000000
# Chunk frames during materialization; default 100000. Set 0 only if you intentionally want no frame cap.
SOCKET_REST_SQL_STREAM_MATERIALIZE_MAX_CHUNKS=100000
# Audit retention policy for socket events (default: 90 days, run every 1440 minutes)
SOCKET_AUDIT_RETENTION_DAYS=90
SOCKET_AUDIT_RETENTION_INTERVAL_MINUTES=1440
SOCKET_AUDIT_PRUNE_BATCH_SIZE=5000
# Batched socket audit inserts (1 = legacy single INSERT per event; >1 groups into one transaction)
SOCKET_AUDIT_BATCH_MAX=48
SOCKET_AUDIT_BATCH_FLUSH_MS=200
# In-memory audit queue cap; absorbs DB stalls without dropping rows (schema default = 50000).
SOCKET_AUDIT_MAX_QUEUE=50000
# Percent of relay:rpc.chunk audit rows persisted. If unset: NODE_ENV=production → 25; else 100.
SOCKET_AUDIT_HIGH_VOLUME_SAMPLE_PERCENT=100

# Optional: PostgreSQL rows with per-phase timings for REST, consumer agents:command, and relay (see docs/observability.md).
BRIDGE_LATENCY_TRACE_ENABLED=false
# Random sample % for fast successful commands; errors/timeouts always persisted when tracing is on.
BRIDGE_LATENCY_TRACE_SAMPLE_PERCENT=100
# Also persist when total wall time (ms) is >= this (0 = off).
BRIDGE_LATENCY_TRACE_SLOW_TOTAL_MS=0
BRIDGE_LATENCY_TRACE_BATCH_MAX=48
BRIDGE_LATENCY_TRACE_BATCH_FLUSH_MS=200
# Max in-memory queued rows before dropping (default 50000). Set 0 only if you intentionally want no cap.
BRIDGE_LATENCY_TRACE_MAX_QUEUE=50000
BRIDGE_LATENCY_TRACE_RETENTION_DAYS=90
BRIDGE_LATENCY_TRACE_RETENTION_INTERVAL_MINUTES=1440
BRIDGE_LATENCY_TRACE_PRUNE_BATCH_SIZE=5000
# OpenTelemetry span per command (requires a globally configured tracer).
BRIDGE_LATENCY_TRACE_OTEL_ENABLED=false
# Warn when |total_ms - phases_sum_ms| exceeds this (0 = off). Increments plug_bridge_latency_trace_phases_mismatch_total.
BRIDGE_LATENCY_TRACE_PHASES_MISMATCH_WARN_MS=0
# true = do not persist user_id in bridge_latency_traces (PII reduction in DB + traces path).
BRIDGE_LATENCY_TRACE_REDACT_USER_ID=false
# Max characters of request_id to store (0 = full string).
BRIDGE_LATENCY_TRACE_TRUNCATE_REQUEST_ID_CHARS=0
# Retention days for channel=relay only; leave empty to use BRIDGE_LATENCY_TRACE_RETENTION_DAYS.
# BRIDGE_LATENCY_TRACE_RELAY_RETENTION_DAYS=

# Agent profile maintenance: history retention and idempotency TTL.
AGENT_PROFILE_REVISION_RETENTION_DAYS=180
AGENT_PROFILE_IDEMPOTENCY_RETENTION_DAYS=30
AGENT_PROFILE_MAINTENANCE_INTERVAL_MINUTES=1440
AGENT_PROFILE_MAINTENANCE_PRUNE_BATCH_SIZE=5000

# Client -> Agent access expiry sweep: expire pending requests whose approval token elapsed.
CLIENT_AGENT_ACCESS_EXPIRY_SWEEP_INTERVAL_MINUTES=60
CLIENT_AGENT_ACCESS_EXPIRY_SWEEP_BATCH_SIZE=1000

# In-process TTL caches — reduces DB queries on the hot path (agents/commands + socket relay).
# Set to 0 to disable a cache. Increasing TTL reduces DB load but delays access-revocation enforcement.
AGENT_ACCESS_CACHE_TTL_MS=30000
AGENT_ACCESS_CACHE_MAX_SIZE=5000
PRINCIPAL_SNAPSHOT_CACHE_TTL_MS=15000
PRINCIPAL_SNAPSHOT_CACHE_MAX_SIZE=2000

# Convention: `REST_*_RATE_LIMIT_MAX=0` disables that HTTP rate limiter group (unlimited). Same for REST_CLIENT_* password-recovery/thumbnail limits when listed in env.ts.

# REST global rate-limit applied to every /api/v1 request (per IP).
REST_GLOBAL_RATE_LIMIT_WINDOW_MS=900000
REST_GLOBAL_RATE_LIMIT_MAX=300
# REST credential-auth rate-limit: login/register/password-recovery (per IP).
REST_CREDENTIAL_AUTH_RATE_LIMIT_WINDOW_MS=900000
REST_CREDENTIAL_AUTH_RATE_LIMIT_MAX=25
# POST .../refresh only (per IP).
REST_TOKEN_REFRESH_RATE_LIMIT_WINDOW_MS=900000
REST_TOKEN_REFRESH_RATE_LIMIT_MAX=400

# Optional: shared HTTP rate-limit state across hub replicas (`express-rate-limit` + Redis). Empty = in-memory per process.
# Production: prefer rediss:// (TLS) or include credentials. Without auth, bind Redis to 127.0.0.1
# or restrict network access via VPC/firewall. See docs/redis_security.md.
# REST_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379

# Optional: shared Socket rate-limit state across hub replicas. Empty = in-memory per process.
# Sticky sessions are still required for Socket bridge/relay state.
# Production: see auth/TLS guidance above and docs/redis_security.md.
# SOCKET_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379

# Optional: distributed idempotency for REST/Socket `client:custom.*` publishes.
# Use the same Redis cluster as SOCKET_IO_REDIS_ADAPTER_URL when operating multiple replicas.
# If the distributed room count fails while the Redis adapter is active, the hub only emits in
# best-effort mode while the local room stays under REST_SOCKET_EVENT_BEST_EFFORT_LOCAL_MAX_RECIPIENTS.
# Repeated failures open a short local circuit and turn publishes into retryable 503s.
# Production: see auth/TLS guidance above and docs/redis_security.md.
# REST_SOCKET_EVENT_IDEMPOTENCY_REDIS_URL=redis://127.0.0.1:6379
# REST_SOCKET_EVENT_IDEMPOTENCY_REDIS_LOCK_TTL_MS=5000
# REST_SOCKET_EVENT_IDEMPOTENCY_REDIS_WAIT_MS=750

# Optional: read-replica URL for idempotency `getEntry` (Sprint 11). Writes still go to the
# primary above. Tolerant to replication lag because the post-lock re-read uses the primary.
# Set to a separate replica when your Redis topology supports read scaling
# (Sentinel/managed: see docs/redis_security.md). Empty = use primary for reads.
# REST_SOCKET_EVENT_IDEMPOTENCY_REDIS_READ_URL=redis://127.0.0.1:6379

# Default node-redis client tuning shared by every Redis-backed module above (rate-limits, idempotency).
# The Socket.IO adapter keeps its own knobs (SOCKET_IO_REDIS_ADAPTER_*) for backwards compatibility.
# REDIS_DEFAULT_CONNECT_TIMEOUT_MS=5000
# REDIS_DEFAULT_RECONNECT_BASE_MS=200
# REDIS_DEFAULT_RECONNECT_MAX_MS=5000

# Local circuit breaker shared by the socket + REST rate-limit Redis modules.
# After this many consecutive command failures the module fails open to its
# in-memory limiter for REDIS_RATE_LIMIT_CIRCUIT_OPEN_MS before retrying.
# Threshold 0 disables the breaker (every command hits Redis).
# REDIS_RATE_LIMIT_CIRCUIT_FAILURE_THRESHOLD=3
# REDIS_RATE_LIMIT_CIRCUIT_OPEN_MS=5000

# When STRICT_REDIS_AUTH=true and NODE_ENV=production, refuse to boot if any *_REDIS_URL above
# uses redis:// without password. Use rediss:// (TLS) or redis://default:<password>@host instead.
# STRICT_REDIS_AUTH=false

# Optional: multi-tenancy via `REDIS_TENANT_ID` (Sprint 12). When set, every Redis key carries the
# tenant id inside the hash tag (e.g. `plug_socket_rl:{plug}:acme:scope:user:abc`) so multiple
# tenants sharing one Redis instance never collide. Match `^[A-Za-z0-9_-]{1,32}$`. Empty = single
# tenant (legacy `{plug}` only). See docs/adrs/0006-redis-multi-tenancy.md.
# REDIS_TENANT_ID=

# Optional: OpenTelemetry spans for hot-path Redis commands (Sprint 9). Requires
# OTEL_TRACES_ENABLED=true. Each Redis command emits `redis.<module>.<op>` with PII-safe
# attributes (`redis.module`, `redis.op`, `redis.key.prefix`).
# REDIS_OTEL_SPANS_ENABLED=false

# Redlock-style watchdog: renew the distributed idempotency lock every N ms while a publish
# is in-flight (recommended ~LOCK_TTL_MS / 3). 0 keeps legacy fixed-TTL behaviour.
# REST_SOCKET_EVENT_IDEMPOTENCY_REDIS_LOCK_RENEWAL_MS=0

# Optional: per-recipient Redis Streams backlog for at-least-once delivery of `client:custom.*`
# frames across hub replicas. Default disabled (pub/sub-only). Use a SEPARATE Redis DB from
# rate-limits/idempotency and configure `maxmemory-policy=noeviction` so backlog frames are
# never silently dropped. See docs/redis_streams_agent_backlog.md.
# AGENT_EVENT_STREAM_REDIS_URL=redis://127.0.0.1:6379
# AGENT_EVENT_STREAM_ENABLED=false
# AGENT_EVENT_STREAM_MAX_LEN=1000
# AGENT_EVENT_STREAM_TTL_MS=86400000
# AGENT_EVENT_STREAM_BACKLOG_MAX_ENTRIES=500
# Comma-separated allowlist of recipient principal ids that should hit the Stream backlog.
# Empty = every principal. Useful for staged rollout.
# AGENT_EVENT_STREAM_AGENT_ALLOWLIST=
# Per-subscribe drain: how long to wait for the client ack before falling back to fire-and-forget.
# AGENT_EVENT_STREAM_DRAIN_ACK_TIMEOUT_MS=1000

# Sprint 10 — consumer groups: when true, drain reads via XREADGROUP/XACK so cross-replica
# delivery of the same recipient is coordinated. XGROUP CREATE MKSTREAM is lazy (BUSYGROUP swallowed).
# AGENT_EVENT_STREAM_USE_CONSUMER_GROUPS=false
# AGENT_EVENT_STREAM_CONSUMER_GROUP=plug_hub

# Sprint 10 — backpressure for the post-emit XADD batch (P1 pipelined as MULTI/EXEC).
#   await           — publish blocks until appends resolve. Preserves at-least-once.
#   timeout         — race against AGENT_EVENT_STREAM_APPEND_TIMEOUT_MS, then return.
#   fire_and_forget — publish never waits. Failures only surface in metrics/logs.
# AGENT_EVENT_STREAM_APPEND_MODE=await
# AGENT_EVENT_STREAM_APPEND_TIMEOUT_MS=50

# REST POST /api/v1/agents/commands — rate limit (per authenticated user JWT sub; same window for IP limit when enabled)
# Dashboards with many agents may issue one command per agent per refresh; consider 600–1200/min for 50–60 agents.
REST_AGENTS_COMMANDS_RATE_LIMIT_WINDOW_MS=60000
# Per authenticated user (`JWT sub`). `0` = unlimited for HTTP POST + matching socket consumer limiter.
REST_AGENTS_COMMANDS_RATE_LIMIT_MAX=100
# 0 = per-IP limiter off; use e.g. 300 behind shared NAT (enable Express trust proxy for req.ip)
REST_AGENTS_COMMANDS_RATE_LIMIT_IP_MAX=0

# PATCH /api/v1/agents/{agentId}/profile — agent self-service (per JWT sub). 0 = unlimited (schema default = 20/min).
REST_AGENTS_SELF_PROFILE_RATE_LIMIT_WINDOW_MS=60000
REST_AGENTS_SELF_PROFILE_RATE_LIMIT_MAX=20

# PATCH /api/v1/admin/users/:id/status — per admin (JWT sub)
REST_ADMIN_USER_STATUS_RATE_LIMIT_WINDOW_MS=60000
REST_ADMIN_USER_STATUS_RATE_LIMIT_MAX=60

# E2E (npm run test:e2e) — full HTTP + Socket.IO; see tests/e2e/ and docs/e2e_benchmark_hub_agent.md
# When not "true", the script exits 0 without running Vitest (safe for default dev/CI).
# When "true": same stack as a dev server — DATABASE_URL must reach a running Postgres (auth/register uses Prisma).
# `npm run test:e2e` performs a Prisma preflight (`SELECT 1`) before Vitest starts.
# If the database is unavailable, the script fails fast and suggests `npm run db:container:up`.
E2E_TESTS_ENABLED=false

# Integration tests that need Redis (socket rate limits, distributed client:custom.* fan-out).
# When "true" (or in CI), Vitest probes redis://127.0.0.1:6379 when SOCKET_* / REST_SOCKET_EVENT_* URLs are unset.
# Locally: start Redis (or docker run -p 6379:6379 redis:7-alpine) and Postgres before `npm test`.
# In CI with INTEGRATION_REDIS_TESTS_ENABLED=true, unreachable Redis/Postgres fails the job instead of silent skip.
# INTEGRATION_REDIS_TESTS_ENABLED=false
# Enables the Redis chaos/failover integration suites (also test-only; requires a reachable local Redis).
# INTEGRATION_REDIS_CHAOS_TESTS_ENABLED=false

# Optional: stable id for this hub process (pod name, UUID). When set, every Express response
# (REST, Swagger, /metrics, 404) carries header X-Hub-Instance-Id, so clients can validate
# sticky-session affinity behind multi-replica deployments.
# HUB_INSTANCE_ID=

# POST /api/v1/client/me/agents — per-client rate limit (window ms / max requests in window).
REST_CLIENT_ME_AGENTS_POST_RATE_LIMIT_WINDOW_MS=900000
REST_CLIENT_ME_AGENTS_POST_RATE_LIMIT_MAX=60
REST_CLIENT_THUMBNAIL_RATE_LIMIT_WINDOW_MS=60000
REST_CLIENT_THUMBNAIL_RATE_LIMIT_MAX=20
REST_CLIENT_PASSWORD_RECOVERY_RATE_LIMIT_WINDOW_MS=300000
REST_CLIENT_PASSWORD_RECOVERY_RATE_LIMIT_MAX=10
# When >0, a second POST for the same agent while still pending and within this many ms of requestedAt does not re-email the owner (response field debounced). 0 disables.
CLIENT_AGENT_ACCESS_REQUEST_EMAIL_DEBOUNCE_MS=0
# Max retries a client can make per agent access request (0 = unlimited)
CLIENT_AGENT_ACCESS_MAX_RETRIES=5
# REST -> Socket custom pub/sub publish (`POST /api/v1/client/me/socket-events`).
# REST_SOCKET_EVENT_RATE_LIMIT_WINDOW_MS=60000
# REST_SOCKET_EVENT_RATE_LIMIT_MAX=120
# REST_SOCKET_EVENT_MAX_FILES=5
# REST_SOCKET_EVENT_FILE_MAX_BYTES=524288
# REST_SOCKET_EVENT_TOTAL_FILES_MAX_BYTES=2097152
# REST_SOCKET_EVENT_PAYLOAD_JSON_MAX_BYTES=524288
# REST_SOCKET_EVENT_MAX_RECIPIENTS=0
# Production recommendation: set REST_SOCKET_EVENT_MAX_RECIPIENTS > 0 for large `client:custom.*` rooms.
# REST_SOCKET_EVENT_BEST_EFFORT_LOCAL_MAX_RECIPIENTS=256
# REST_SOCKET_EVENT_DISTRIBUTED_COUNT_FAILURE_THRESHOLD=5
# REST_SOCKET_EVENT_DISTRIBUTED_COUNT_FAILURE_OPEN_MS=30000
# Hint (ms) for error.details.retry_after_ms when fan-out exceeds REST_SOCKET_EVENT_MAX_RECIPIENTS (default 2000; independent of REST_SOCKET_EVENT_RATE_LIMIT_WINDOW_MS).
# REST_SOCKET_EVENT_FANOUT_RETRY_AFTER_MS=2000
# REST_SOCKET_EVENT_IDEMPOTENCY_TTL_MS=300000
# REST_SOCKET_EVENT_IDEMPOTENCY_MAX_ENTRIES=10000
# Optional cap on concurrent distinct idempotency serialization chains per process (0 = unlimited).
# REST_SOCKET_EVENT_IDEMPOTENCY_SERIALIZATION_MAX_KEYS=0
# Express `express.json` limit for JSON-only `POST /api/v1/client/me/socket-events` (not global). Empty = derive ~110% from REST_SOCKET_EVENT_*.
# REST_SOCKET_EVENT_HTTP_JSON_BODY_LIMIT=12mb
# Opcional: limites só para `socket:event.publish` (omitir = espelhar REST_SOCKET_EVENT_RATE_LIMIT_*)
# SOCKET_CUSTOM_EVENT_PUBLISH_RATE_LIMIT_WINDOW_MS=60000
# SOCKET_CUSTOM_EVENT_PUBLISH_RATE_LIMIT_MAX=120

SWAGGER_ENABLED=true

# =============================================================================
# Performance presets (optional) — copy lines into your .env; see docs/performance_hub_agent.md
# =============================================================================
# High throughput: larger stream window + relay chunk buffers (more RAM):
# SOCKET_REST_STREAM_PULL_WINDOW_SIZE=512
# SOCKET_RELAY_MAX_BUFFERED_CHUNKS_PER_REQUEST=512
# SOCKET_RELAY_MAX_TOTAL_BUFFERED_CHUNKS=51200
# SOCKET_RELAY_MAX_BUFFERED_BYTES_PER_REQUEST=33554432
# SOCKET_RELAY_MAX_TOTAL_BUFFERED_BYTES=536870912
#
# Earlier async zlib (large/medium compressed traffic):
# PAYLOAD_FRAME_ASYNC_GZIP_MIN_UTF8_BYTES=65536
# PAYLOAD_FRAME_ASYNC_GUNZIP_MIN_COMPRESSED_BYTES=32768
#
# Try gzip on larger hub→agent JSON (more CPU; up to 10 MiB frame cap):
# PAYLOAD_FRAME_MAX_GZIP_INPUT_BYTES=1048576
#
# Small VM: fewer async zlib calls + less frequent idempotency sweep:
# PAYLOAD_FRAME_ASYNC_GZIP_MIN_UTF8_BYTES=262144
# PAYLOAD_FRAME_ASYNC_GUNZIP_MIN_COMPRESSED_BYTES=131072
# SOCKET_RELAY_IDEMPOTENCY_CLEANUP_INTERVAL_MS=180000
#
# Multi-agent dashboard (~60 agentes paralelos, 1 hub, RAM suficiente) — preset produção completo:
# SOCKET_AUTH_ACCOUNT_SNAPSHOT_TTL_MS=30000
# SOCKET_CONSUMER_AGENT_ACCESS_SNAPSHOT_TTL_MS=15000
# AGENT_ACCESS_CACHE_TTL_MS=60000
# PRINCIPAL_SNAPSHOT_CACHE_TTL_MS=30000
# AGENT_REGISTER_BIND_CACHE_TTL_MS=30000
# SOCKET_CONSUMER_MAX_INFLIGHT_PER_SOCKET=512
# SOCKET_CUSTOM_EVENT_PUBLISH_MAX_INFLIGHT_PER_SOCKET=128
# SOCKET_REST_STREAM_PULL_WINDOW_SIZE=512
# SOCKET_REST_STREAM_PULL_MAX_WINDOW_SIZE=512
# SOCKET_REST_SQL_STREAM_MATERIALIZE_MAX_CHUNKS=100000
# PAYLOAD_FRAME_MAX_GZIP_INPUT_BYTES=1048576
# SOCKET_IO_PING_INTERVAL_MS=30000
# SOCKET_IO_PING_TIMEOUT_MS=25000
# SOCKET_AUDIT_BATCH_MAX=64
# SOCKET_AUDIT_HIGH_VOLUME_SAMPLE_PERCENT=10
# SOCKET_CLIENT_AGENT_PROFILE_PUSH_ENABLED=false
# SOCKET_CONSUMER_CLIENT_AGENT_ROOM_RECONCILE_INTERVAL_MS=60000
# SWAGGER_ENABLED=false
# DATABASE_URL=...&connection_limit=15&pool_timeout=20
# Omitir REST_RATE_LIMIT_REDIS_URL quando *_RATE_LIMIT_MAX=0 (instância única)
#
# Rate limits generosos (dashboard multi-agente; *_MAX=0 = ilimitado):
# REST_GLOBAL_RATE_LIMIT_MAX=0
# REST_CREDENTIAL_AUTH_RATE_LIMIT_MAX=0
# REST_TOKEN_REFRESH_RATE_LIMIT_MAX=0
# REST_AGENTS_COMMANDS_RATE_LIMIT_MAX=0
# REST_SOCKET_EVENT_RATE_LIMIT_MAX=0
# SOCKET_CUSTOM_EVENT_PUBLISH_RATE_LIMIT_MAX=0
# SOCKET_RELAY_RATE_LIMIT_MAX_REQUESTS=0
# SOCKET_RELAY_RATE_LIMIT_MAX_CONVERSATION_STARTS=0
# SOCKET_CUSTOM_EVENT_SUBSCRIPTION_RATE_LIMIT_MAX=0
