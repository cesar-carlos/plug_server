# Referencia de producao (plug-server.se7esistemassinop.com.br)
#
# Em Ubuntu/Debian o Nginx ja tem `http { include /etc/nginx/conf.d/*.conf; include sites-enabled; }`.
# Instalar os fragmentos abaixo e o site, depois: nginx -t && systemctl reload nginx
#
# Ficheiros no servidor (exemplos de paths):
#   /etc/nginx/conf.d/00-connection-upgrade-map.conf   # map $connection_upgrade
#   /etc/nginx/conf.d/01-plug-rate-limit.conf          # limit_req_zone / limit_conn_zone
#   /etc/nginx/snippets/plug_server_proxy.conf         # headers + proxy_pass
#   /etc/nginx/sites-available/plug-server...          # server { ... }
#
# UPLOADS_DIR no .env deve ser o mesmo path que `alias` em location /uploads/

# --- /etc/nginx/conf.d/00-connection-upgrade-map.conf ---
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- /etc/nginx/conf.d/02-plug-upstream.conf (multi-replica) ---
# Sticky session OBRIGATORIA para Socket.IO em multi-replica (relay/bridge guardam
# estado por processo): com ip_hash, o mesmo IP cai sempre na mesma replica.
# - Opcao A (built-in): `ip_hash` (abaixo). Simples, sem modulo extra.
# - Opcao B (cookie):   requer `nginx-sticky-module-ng` ou nginx Plus.
# Em deploy single-instance, deixe so um `server 127.0.0.1:4000;` e remova ip_hash.
#
# As 3 portas batem com deploy/pm2/ecosystem.config.cjs (uma fork por core).
upstream plug_server_upstream {
    ip_hash;                                                 # Opcao A (sticky)
    # sticky cookie hub_node expires=1h path=/;              # Opcao B (alternativa)
    server 127.0.0.1:4000;
    server 127.0.0.1:4001;
    server 127.0.0.1:4002;
    keepalive 64;
}

# --- /etc/nginx/conf.d/01-plug-rate-limit.conf ---
limit_req_zone $binary_remote_addr zone=plug_auth_strict:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=plug_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=plug_metrics:10m rate=120r/m;
limit_conn_zone $binary_remote_addr zone=plug_conn:10m;

# --- /etc/nginx/conf.d/03-plug-gzip.conf ---
# Coordenacao com a app Node: a partir de plug_server >=1.x, o Express aplica
# `compression` em respostas >=1 KiB quando o cliente envia `Accept-Encoding`.
# Mantenha `gzip_proxied off` (default do nginx) para nao recomprimir respostas
# que chegam ja gzipadas do upstream. Nginx continua livre para comprimir o
# que serve diretamente (ex.: estaticos via `alias` em /uploads/).
#
# Para forcar gzip do lado do nginx (e ignorar o Express), defina aqui
# `gzip_proxied any` E adicione um middleware no Node que respeite o header
# `X-No-Compression: 1` injetado pelo proxy. Cuidado: comprimir duas vezes
# (Express -> nginx) corrompe `Content-Encoding`.
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_proxied off;
gzip_types
    application/json
    application/javascript
    application/xml
    text/css
    text/html
    text/plain
    text/xml
    image/svg+xml;

# --- /etc/nginx/snippets/plug_server_proxy.conf ---
# proxy_http_version 1.1;
# proxy_set_header Upgrade $http_upgrade;
# proxy_set_header Connection $connection_upgrade;
# proxy_set_header Host $host;
# proxy_set_header X-Real-IP $remote_addr;
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# proxy_set_header X-Forwarded-Proto $scheme;
# proxy_set_header X-Forwarded-Host $host;
# proxy_set_header X-Forwarded-Port $server_port;
# Multi-replica: aponte para o upstream com sticky (02-plug-upstream.conf).
# proxy_pass http://plug_server_upstream;
# Single-instance: use o host:porta direto em vez do upstream.
# proxy_pass http://127.0.0.1:4000;

