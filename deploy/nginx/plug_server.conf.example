# Nginx reference for plug_server (single instance on 127.0.0.1:4000)
#
# Install (Ubuntu/Debian):
#   sudo cp deploy/nginx/conf.d/*.conf /etc/nginx/conf.d/
#   sudo cp deploy/nginx/snippets/plug_server_proxy.conf /etc/nginx/snippets/
#   sudo cp deploy/nginx/sites/plug-server.example.conf /etc/nginx/sites-available/<your-host>
#   sudo ln -sf /etc/nginx/sites-available/<your-host> /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Full guide: docs/nginx_production.md
#
# UPLOADS_DIR in .env must match the alias path in the site file (/uploads/).
